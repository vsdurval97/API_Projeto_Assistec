@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <div class="orc-dialog-cabecalho">
            <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@_model.Numero</MudText>
            <MudChip T="string" Size="Size.Small" Style="@($"background-color:{OrcamentoUi.Cor(_model.Status).Bg}; color:{OrcamentoUi.Cor(_model.Status).Texto};")">@OrcamentoUi.Rotulo(_model.Status)</MudChip>
            <MudText Typo="Typo.caption" Style="color:#5A6B7A;">Preencha os dados comerciais, os itens e as condições da proposta.</MudText>
        </div>

        <div class="orc-dialog-conteudo">
            <MudTabs Elevation="0" Rounded="true" PanelClass="pt-4">

                <MudTabPanel Text="Dados Gerais">
                    <div class="orc-form-grid">
                        <div class="orc-span-2">
                            <MudSelect T="string" @bind-Value="_model.ClienteCodigo" Label="Cliente" Required="true"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var cliente in OrcamentoMockData.Clientes)
                                {
                                    <MudSelectItem T="string" Value="@cliente.Codigo">@cliente.Nome</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                        <MudTextField T="string" Value="_model.ClienteDocumento" Label="CPF / CNPJ" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField T="string" Value="_model.ClienteTelefone" Label="Telefone" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />

                        <div class="orc-span-2">
                            <MudTextField T="string" Value="_model.ClienteEmail" Label="E-mail" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                        <MudTextField T="string" Value="@_model.Emissao.ToString("dd/MM/yyyy")" Label="Emissão" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudDatePicker @bind-Date="_model.Validade" Label="Validade" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />

                        <div class="orc-span-2">
                            <MudSelect T="string" @bind-Value="_model.Vendedor" Label="Vendedor" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var vendedor in OrcamentoMockData.Vendedores)
                                {
                                    <MudSelectItem T="string" Value="@vendedor">@vendedor</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                        <div class="orc-span-2">
                            <MudSelect T="StatusOrcamento" @bind-Value="_model.Status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var status in Enum.GetValues<StatusOrcamento>())
                                {
                                    <MudSelectItem T="StatusOrcamento" Value="@status">@OrcamentoUi.Rotulo(status)</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@($"Produtos e Serviços ({_model.Itens.Count})")">
                    <div class="orc-item-aviso">
                        <div>
                            <MudText Typo="Typo.body2" Style="font-weight:600;">Produtos e serviços do orçamento</MudText>
                            <MudText Typo="Typo.caption" Style="color:#9AA5B1;">Pesquise no catálogo para incluir um novo item.</MudText>
                        </div>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search" OnClick="AbrirBuscaItem">
                            Buscar Item
                        </MudButton>
                    </div>

                    <div style="overflow-x:auto; margin-top:16px;">
                        <table class="orc-itens-table">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Descrição</th>
                                    <th>Quantidade</th>
                                    <th>Valor Unitário</th>
                                    <th class="col-num">Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _model.Itens)
                                {
                                    var corTipo = OrcamentoUi.Cor(item.Tipo);
                                    <tr>
                                        <td><MudChip T="string" Size="Size.Small" Style="@($"background-color:{corTipo.Bg}; color:{corTipo.Texto};")">@OrcamentoUi.Rotulo(item.Tipo)</MudChip></td>
                                        <td>
                                            <MudText Typo="Typo.body2" Style="font-weight:600;">@item.Descricao</MudText>
                                            <MudText Typo="Typo.caption" Style="color:#9AA5B1;">@item.Codigo</MudText>
                                        </td>
                                        <td>
                                            <MudNumericField T="int" @bind-Value="item.Quantidade" Min="1" HideSpinButtons="true"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:90px;" />
                                        </td>
                                        <td>
                                            <MudNumericField T="double" @bind-Value="item.ValorUnitario" Min="0" HideSpinButtons="true"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:130px;" />
                                        </td>
                                        <td class="col-num"><MudText Typo="Typo.body2" Style="font-weight:700;">@item.SubtotalFormatado</MudText></td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Style="color:#9AA5B1;"
                                                           OnClick="() => RemoverItem(item)" />
                                        </td>
                                    </tr>
                                }

                                @if (_model.Itens.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" style="text-align:center; padding:32px 0;">
                                            <MudText Typo="Typo.body2" Style="color:#9AA5B1;">Nenhum item adicionado ao orçamento.</MudText>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Valores e Condições">
                    <div class="orc-fechamento-grid">
                        <div class="orc-fechamento-coluna">
                            <MudSelect T="string" @bind-Value="_model.CondicaoPagamento" Label="Condição de Pagamento" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var condicao in OrcamentoMockData.CondicoesPagamento)
                                {
                                    <MudSelectItem T="string" Value="@condicao">@condicao</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField T="string" @bind-Value="_model.Observacao" Label="Observações da Proposta"
                                          Lines="7" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>

                        <div class="orc-resumo-box">
                            <MudText Typo="Typo.caption" Class="orc-card-titulo">Resumo Financeiro</MudText>
                            <div class="orc-resumo-linha">
                                <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Subtotal</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">@_model.SubtotalFormatado</MudText>
                            </div>
                            <div class="orc-resumo-linha">
                                <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Desconto</MudText>
                                <MudNumericField T="double" @bind-Value="_model.Desconto" Min="0" HideSpinButtons="true"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:130px;" />
                            </div>
                            <div class="orc-resumo-linha">
                                <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Frete</MudText>
                                <MudNumericField T="double" @bind-Value="_model.Frete" Min="0" HideSpinButtons="true"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:130px;" />
                            </div>

                            <MudDivider Class="my-3" />

                            <div class="orc-resumo-linha">
                                <MudText Typo="Typo.body1" Style="font-weight:700;">Total</MudText>
                                <MudText Typo="Typo.h6" Style="font-weight:700; color:#2C6FB0;">@_model.TotalFormatado</MudText>
                            </div>
                        </div>
                    </div>
                </MudTabPanel>

            </MudTabs>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="orc-dialog-rodape">
            <MudText Typo="Typo.caption" Style="color:#9AA5B1;">@_model.Itens.Count item(ns) · @_model.TotalFormatado</MudText>
            <MudSpacer />
            <MudButton OnClick="Cancelar">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(!PodeSalvar)" OnClick="Salvar">
                @(Edicao ? "Salvar Alterações" : "Salvar")
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public OrcamentoItem? OrcamentoExistente { get; set; }

    private OrcamentoItem _model = new();

    private bool Edicao => OrcamentoExistente is not null;

    private bool PodeSalvar => !string.IsNullOrWhiteSpace(_model.ClienteCodigo) && _model.Itens.Count > 0;

    protected override void OnInitialized()
    {
        _model = OrcamentoExistente?.Clonar() ?? new OrcamentoItem
        {
            Numero = OrcamentoMockData.ProximoNumero(),
            Emissao = DateTime.Today,
            Validade = DateTime.Today.AddDays(7),
            Vendedor = OrcamentoMockData.Vendedores[0],
            CondicaoPagamento = "À vista",
            Status = StatusOrcamento.Rascunho
        };
    }

    private async Task AbrirBuscaItem()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<BuscaItemOrcamento>("Buscar Produto ou Serviço", options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ItemOrcamentoLinha item })
        {
            _model.Itens.Add(item);
        }
    }

    private void RemoverItem(ItemOrcamentoLinha item) => _model.Itens.Remove(item);

    private void Salvar()
    {
        OrcamentoMockData.Salvar(_model);
        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancelar() => MudDialog.Cancel();
}