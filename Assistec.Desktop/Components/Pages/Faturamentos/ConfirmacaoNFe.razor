<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:600;">
            @(Acao == AcaoConfirmacaoNFe.Excluir ? "Excluir esta NF-e?" : "Inutilizar esta numeração?")
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Style="color:#5A6B7A;">
            @if (Acao == AcaoConfirmacaoNFe.Excluir)
            {
                <text>O rascunho será removido definitivamente. Esta ação só é permitida para documentos que ainda não foram autorizados pela SEFAZ.</text>
            }
            else
            {
                <text>A faixa correspondente ao número @Numero, série @Serie, será inutilizada e não poderá ser usada novamente.</text>
            }
        </MudText>

        @if (Acao == AcaoConfirmacaoNFe.Inutilizar)
        {
            <MudTextField T="string" Label="Justificativa" Required="true"
                          @bind-Value="_justificativa" Immediate="true"
                          Lines="3" Class="mt-4"
                          Placeholder="Informe o motivo da inutilização (mínimo de 15 caracteres)..."
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudText Typo="Typo.caption" Style="@(_justificativaValida ? "color:#2E7D32;" : "color:#9AA5B1;")">
                @_justificativa.Trim().Length/15 caracteres mínimos
            </MudText>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="@(Acao == AcaoConfirmacaoNFe.Excluir ? Color.Error : Color.Warning)"
                   Disabled="@(Acao == AcaoConfirmacaoNFe.Inutilizar && !_justificativaValida)"
                   OnClick="Confirmar">
            @(Acao == AcaoConfirmacaoNFe.Excluir ? "Excluir NF-e" : "Confirmar Inutilização")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public AcaoConfirmacaoNFe Acao { get; set; }
    [Parameter] public string Numero { get; set; } = "";
    [Parameter] public string Serie { get; set; } = "";

    private string _justificativa = "";
    private bool _justificativaValida => _justificativa.Trim().Length >= 15;

    private void Cancelar() => MudDialog.Cancel();

    private void Confirmar() => MudDialog.Close(DialogResult.Ok(_justificativa.Trim()));
}