<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:600;">Selecionar CST / CSOSN</MudText>
        <MudText Typo="Typo.body2" Style="color:#5A6B7A;">
            Escolha a situação tributária do ICMS aplicável ao item.
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudTextField T="string" @bind-Value="_busca"
                      Placeholder="Buscar pelo código ou descrição..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />

        <div class="fat-cst-lista">
            @foreach (var s in _resultados)
            {
                var selecionada = s.Codigo == Atual;
                <div class="fat-cst-opcao @(selecionada ? "fat-cst-selecionada" : "")" @onclick="() => Selecionar(s.Codigo)">
                    <span class="fat-cst-codigo @(s.TemSt && !selecionada ? "fat-cst-st" : "")">@s.Codigo</span>
                    <div style="flex:1;">
                        <div class="fat-cliente">@s.Descricao</div>
                        <div class="fat-sub">@s.Regime@(s.TemSt ? " · Aplicável a operações com substituição tributária" : "")</div>
                    </div>
                    @if (selecionada)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#079cff;" />
                    }
                </div>
            }
            @if (!_resultados.Any())
            {
                <div class="fat-vazio" style="padding:32px 0;">Nenhuma situação tributária encontrada.</div>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudText Typo="Typo.caption" Style="color:#9AA5B1; margin-right:auto; padding-left:8px;">
            @_resultados.Count() opção(ões)
        </MudText>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Atual { get; set; } = "";

    private string _busca = "";

    private IEnumerable<SituacaoTributaria> _resultados =>
        FaturamentoMockData.Situacoes.Where(s =>
            string.IsNullOrWhiteSpace(_busca) ||
            s.Codigo.Contains(_busca) ||
            s.Descricao.Contains(_busca, StringComparison.OrdinalIgnoreCase));

    private void Selecionar(string codigo) => MudDialog.Close(DialogResult.Ok(codigo));

    private void Cancelar() => MudDialog.Cancel();
}