@page "/clientes/novo"
@inject HttpClient Http
@inject System.Text.Json.JsonSerializerOptions Json
@inject NavigationManager Nav
@using AssistenciaTecnica.Api.Dtos
@using System.ComponentModel.DataAnnotations

<a href="/clientes" class="link-voltar">← Voltar aos Clientes</a>
<h1>Novo Cliente</h1>
<p class="subtitulo">Cadastro rápido — só nome e telefone são obrigatórios.</p>

<EditForm Model="modelo" OnValidSubmit="Salvar" class="formulario">
    <DataAnnotationsValidator />

    <div class="campo">
        <label for="nome">Nome</label>
        <InputText id="nome" @bind-Value="modelo.Nome" />
        <ValidationMessage For="() => modelo.Nome" />
    </div>

    <div class="campo">
        <label for="telefone">Telefone</label>
        <InputText id="telefone" @bind-Value="modelo.Telefone" />
        <ValidationMessage For="() => modelo.Telefone" />
    </div>

    @if (erro is not null)
    {
        <p style="color: red;">@erro</p>
    }

    <div class="acoes-formulario">
        <button type="submit" class="botao-primario" disabled="@salvando">
            @(salvando ? "Salvando..." : "Salvar")
        </button>
    </div>
</EditForm>

@code {
    private ModeloFormulario modelo = new();
    private bool salvando;
    private string? erro;

    protected override void OnInitialized()
    {
        // O EditForm exige um Model desde o início. As validações reais
        // (Required, StringLength) só se aplicam no submit — usar o
        // mesmo record CriarClienteDto exigiria valores default pros
        // campos obrigatórios, então um modelo simples aqui é mais claro.
    }

    private async Task Salvar()
    {
        salvando = true;
        erro = null;
        try
        {
            var dto = new CriarClienteDto(modelo.Nome!, modelo.Telefone!);
            var resposta = await Http.PostAsJsonAsync("api/Cliente", dto, Json);

            if (resposta.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/clientes");
            }
            else
            {
                erro = $"A API recusou o cadastro (status {(int)resposta.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            salvando = false;
        }
    }

    private class ModeloFormulario
    {
        [Required(ErrorMessage = "O nome do cliente é obrigatório.")]
        [StringLength(150, MinimumLength = 2, ErrorMessage = "O nome deve ter entre 2 e 150 caracteres.")]
        public string? Nome { get; set; }

        [Required(ErrorMessage = "O telefone do cliente é obrigatório.")]
        [StringLength(20, MinimumLength = 8, ErrorMessage = "O telefone deve ter entre 8 e 20 caracteres.")]
        public string? Telefone { get; set; }
    }
}