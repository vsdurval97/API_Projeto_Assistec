<MudDialog>
    <TitleContent>
        <div>
            <MudText Typo="Typo.h6" Style="font-weight:600;">@(VeiculoExistente is null ? "Novo Veículo" : "Editar Veículo")</MudText>
            <MudText Typo="Typo.body2" Style="color:#5A6B7A;">
                @(VeiculoExistente is null ? "Preencha os dados obrigatórios para emissão do MDF-e" : $"{VeiculoExistente.Marca} {VeiculoExistente.Modelo} — {VeiculoExistente.Placa}")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Identificação do Veículo (MDF-e obrigatório)</MudText>

            <div class="veiculo-row-identificacao mt-2">
                <MudTextField @bind-Value="_model.Placa"
                              Label="Placa"
                              Placeholder="ABC1D23"
                              MaxLength="7"
                              Required="true"
                              RequiredError="Campo obrigatório"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Renavam"
                              Label="RENAVAM"
                              Placeholder="00000000000"
                              MaxLength="11"
                              Required="true"
                              RequiredError="Campo obrigatório"
                              Variant="Variant.Outlined" />
                <MudSelect T="string" @bind-Value="_model.Uf" Label="UF Licenc." Required="true" RequiredError="Campo obrigatório" Variant="Variant.Outlined">
                    @foreach (var uf in _ufs)
                    {
                        <MudSelectItem T="string" Value="@uf">@uf</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_model.Chassi"
                              Label="Chassi"
                              Placeholder="9BW000000X0000000"
                              MaxLength="17"
                              Required="true"
                              RequiredError="Campo obrigatório"
                              Variant="Variant.Outlined" />
            </div>

            <div class="veiculo-row-rodado-carroceria mt-4">
                <MudSelect T="TipoRodado" @bind-Value="_model.Rodado" Label="Tipo de Rodado" Required="true" RequiredError="Campo obrigatório" Variant="Variant.Outlined">
                    <MudSelectItem T="TipoRodado" Value="TipoRodado.Truck">01 – Truck</MudSelectItem>
                    <MudSelectItem T="TipoRodado" Value="TipoRodado.Toco">02 – Toco</MudSelectItem>
                    <MudSelectItem T="TipoRodado" Value="TipoRodado.CavaloMecanico">03 – Cavalo Mecânico</MudSelectItem>
                    <MudSelectItem T="TipoRodado" Value="TipoRodado.Van">04 – VAN</MudSelectItem>
                    <MudSelectItem T="TipoRodado" Value="TipoRodado.Utilitario">05 – Utilitário</MudSelectItem>
                    <MudSelectItem T="TipoRodado" Value="TipoRodado.Outros">06 – Outros</MudSelectItem>
                </MudSelect>
                <MudSelect T="TipoCarroceria" @bind-Value="_model.Carroceria" Label="Tipo de Carroceria" Required="true" RequiredError="Campo obrigatório" Variant="Variant.Outlined">
                    <MudSelectItem T="TipoCarroceria" Value="TipoCarroceria.NaoAplicavel">00 – Não Aplicável</MudSelectItem>
                    <MudSelectItem T="TipoCarroceria" Value="TipoCarroceria.Aberta">01 – Aberta</MudSelectItem>
                    <MudSelectItem T="TipoCarroceria" Value="TipoCarroceria.FechadaBau">02 – Fechada / Baú</MudSelectItem>
                    <MudSelectItem T="TipoCarroceria" Value="TipoCarroceria.Graneleira">03 – Graneleira</MudSelectItem>
                    <MudSelectItem T="TipoCarroceria" Value="TipoCarroceria.PortaContainer">04 – Porta Container</MudSelectItem>
                    <MudSelectItem T="TipoCarroceria" Value="TipoCarroceria.Sider">05 – Sider</MudSelectItem>
                </MudSelect>
            </div>

            <div class="transportadora-alerta-info mt-4">
                <MudIcon Icon="@Icons.Material.Filled.Info" Style="color:#C97A3D;" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="color:#9A3412;">
                    <b>Placa</b>, <b>RENAVAM</b>, <b>UF de licenciamento</b>, <b>Chassi</b>, <b>Tipo de Rodado</b> e <b>Tipo de Carroceria</b> são campos obrigatórios no grupo <i>veículos</i> do MDF-e (grupo infMDFe / veicTransp).
                </MudText>
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Capacidade e Peso (MDF-e obrigatório)</MudText>

            <div class="veiculo-row-capacidade mt-2">
                <div>
                    <MudNumericField @bind-Value="_model.TaraKg" Label="Tara (kg)" Placeholder="Ex: 7500" Required="true" RequiredError="Campo obrigatório" Variant="Variant.Outlined" />
                    <MudText Typo="Typo.caption" Style="color:#9AA5B1;">Peso do veículo sem carga</MudText>
                </div>
                <div>
                    <MudNumericField @bind-Value="_model.CapacidadeKg" Label="Cap. de Carga (kg)" Placeholder="Ex: 25000" Required="true" RequiredError="Campo obrigatório" Variant="Variant.Outlined" />
                    <MudText Typo="Typo.caption" Style="color:#9AA5B1;">Capacidade máxima em quilogramas</MudText>
                </div>
                <div>
                    <MudNumericField @bind-Value="_model.CapacidadeM3" Label="Cap. de Carga (m³)" Placeholder="Ex: 90" Required="true" RequiredError="Campo obrigatório" Variant="Variant.Outlined" />
                    <MudText Typo="Typo.caption" Style="color:#9AA5B1;">Capacidade máxima em metros cúbicos</MudText>
                </div>
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Dados Complementares do Veículo</MudText>

            <div class="veiculo-row-complementares mt-2">
                <MudTextField @bind-Value="_model.Marca" Label="Marca" Placeholder="Volvo, Scania, Mercedes..." Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Modelo" Label="Modelo" Placeholder="FH 540, Actros 2546..." Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Ano" Label="Ano Fabricação" Placeholder="2024" MaxLength="4" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Cor" Label="Cor" Placeholder="Branco" Variant="Variant.Outlined" />
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">
                Proprietário do Veículo <span style="text-transform:none; font-weight:400;">(se diferente da transportadora — MDF-e)</span>
            </MudText>

            <div class="veiculo-row-proprietario-1 mt-2">
                <MudTextField @bind-Value="_model.ProprietarioNome" Label="Razão Social / Nome" Placeholder="Nome do proprietário" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.ProprietarioCpfCnpj" Label="CPF / CNPJ" Placeholder="000.000.000-00 ou CNPJ" Variant="Variant.Outlined" />
            </div>

            <div class="veiculo-row-proprietario-2 mt-4">
                <MudTextField @bind-Value="_model.ProprietarioRntrc" Label="RNTRC do Proprietário" Placeholder="00000000" MaxLength="8" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.ProprietarioIe" Label="IE do Proprietário" Placeholder="ISENTO ou número" Variant="Variant.Outlined" />
                <MudSelect T="string" @bind-Value="_model.ProprietarioUf" Label="UF" Variant="Variant.Outlined">
                    @foreach (var uf in _ufs)
                    {
                        <MudSelectItem T="string" Value="@uf">@uf</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="TipoProprietarioVeiculo" @bind-Value="_model.TipoProprietario" Label="Tipo de Proprietário" Variant="Variant.Outlined">
                    <MudSelectItem T="TipoProprietarioVeiculo" Value="TipoProprietarioVeiculo.TacAgregado">TAC-Agregado</MudSelectItem>
                    <MudSelectItem T="TipoProprietarioVeiculo" Value="TipoProprietarioVeiculo.TacIndependente">TAC-Independente</MudSelectItem>
                    <MudSelectItem T="TipoProprietarioVeiculo" Value="TipoProprietarioVeiculo.Outros">Outros</MudSelectItem>
                </MudSelect>
            </div>

            <div class="veiculo-alerta-sucesso mt-4">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#2E7D32;" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="color:#166534;">
                    O tipo de proprietário é obrigatório no MDF-e quando o veículo não pertence ao próprio emitente: <b>TAC-Agregado</b> (vínculo com transportadora), <b>TAC-Independente</b> (autônomo sem vínculo) ou <b>Outros</b> (pessoa jurídica proprietária).
                </MudText>
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Vinculação</MudText>

            <div class="veiculo-row-vinculacao mt-2">
                <MudSelect T="string" @bind-Value="_model.TransportadoraCodigo" Label="Transportadora Responsável" Placeholder="Selecione..." Variant="Variant.Outlined">
                    @foreach (var transportadora in TransportadoraMockData.Transportadoras)
                    {
                        <MudSelectItem T="string" Value="@transportadora.Codigo">@transportadora.NomeFantasia — @transportadora.Cnpj</MudSelectItem>
                    }
                </MudSelect>
                <MudCheckBox T="bool" @bind-Value="_model.Ativo" Label="Veículo ativo" Color="Color.Primary" />
            </div>

            <MudTextField @bind-Value="_model.Observacoes"
                          Label="Observações"
                          Placeholder="Revisão próxima, restrições de rota, observações operacionais..."
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mt-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="Salvar">
            @(VeiculoExistente is null ? "Salvar" : "Salvar Alterações")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public VeiculoItem? VeiculoExistente { get; set; }

    private MudForm _form = null!;
    private VeiculoFormModel _model = new();

    private class VeiculoFormModel
    {
        public string? Placa { get; set; }
        public string? Renavam { get; set; }
        public string Uf { get; set; } = "SP";
        public string? Chassi { get; set; }
        public TipoRodado Rodado { get; set; } = TipoRodado.Truck;
        public TipoCarroceria Carroceria { get; set; } = TipoCarroceria.NaoAplicavel;
        public double TaraKg { get; set; }
        public double CapacidadeKg { get; set; }
        public double CapacidadeM3 { get; set; }
        public string? Marca { get; set; }
        public string? Modelo { get; set; }
        public string? Ano { get; set; }
        public string? Cor { get; set; }
        public string? ProprietarioNome { get; set; }
        public string? ProprietarioCpfCnpj { get; set; }
        public string? ProprietarioRntrc { get; set; }
        public string? ProprietarioIe { get; set; }
        public string ProprietarioUf { get; set; } = "SP";
        public TipoProprietarioVeiculo TipoProprietario { get; set; } = TipoProprietarioVeiculo.Outros;
        public string? TransportadoraCodigo { get; set; }
        public bool Ativo { get; set; } = true;
        public string? Observacoes { get; set; }
    }

    private readonly string[] _ufs =
    {
        "AC","AL","AP","AM","BA","CE","DF","ES","GO",
        "MA","MT","MS","MG","PA","PB","PR","PE","PI",
        "RJ","RN","RS","RO","RR","SC","SP","SE","TO"
    };

    protected override void OnInitialized()
    {
        if (VeiculoExistente is null) return;

        var v = VeiculoExistente;

        _model.Placa = v.Placa;
        _model.Renavam = v.Renavam;
        _model.Uf = v.Uf;
        _model.Chassi = v.Chassi;
        _model.Rodado = v.Rodado;
        _model.Carroceria = v.Carroceria;
        _model.TaraKg = v.TaraKg;
        _model.CapacidadeKg = v.CapacidadeKg;
        _model.CapacidadeM3 = v.CapacidadeM3;
        _model.Marca = v.Marca;
        _model.Modelo = v.Modelo;
        _model.Ano = v.Ano.ToString();
        _model.Cor = v.Cor;
        _model.ProprietarioNome = v.ProprietarioNome;
        _model.ProprietarioCpfCnpj = v.ProprietarioCpfCnpj;
        _model.ProprietarioUf = v.ProprietarioUf;
        _model.TipoProprietario = v.TipoProprietario;
        _model.TransportadoraCodigo = v.TransportadoraCodigo;
        _model.Ativo = v.Status == StatusVeiculo.Ativo;
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Salvar()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}