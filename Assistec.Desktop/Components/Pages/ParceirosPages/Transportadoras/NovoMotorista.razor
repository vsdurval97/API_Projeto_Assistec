<MudDialog>
    <TitleContent>
        <div>
            <MudText Typo="Typo.h6" Style="font-weight:600;">@(MotoristaExistente is null ? "Novo Motorista" : "Editar Motorista")</MudText>
            <MudText Typo="Typo.body2" Style="color:#5A6B7A;">
                @(MotoristaExistente is null ? "Preencha os dados obrigatórios para emissão do MDF-e" : MotoristaExistente.Nome)
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Identificação (MDF-e obrigatório)</MudText>

            <div class="motorista-row-identificacao mt-2">
                <MudTextField @bind-Value="_model.Nome"
                              Label="Nome Completo"
                              Placeholder="Nome completo do motorista"
                              Required="true"
                              RequiredError="Campo obrigatório"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Cpf"
                              Label="CPF"
                              Mask="@(new PatternMask("000.000.000-00"))"
                              Placeholder="000.000.000-00"
                              Required="true"
                              RequiredError="Campo obrigatório"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.DataNascimento"
                              Label="Data de Nascimento"
                              Placeholder="dd/mm/aaaa"
                              Variant="Variant.Outlined" />
            </div>

            <div class="transportadora-alerta-info mt-4">
                <MudIcon Icon="@Icons.Material.Filled.Info" Style="color:#C97A3D;" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="color:#9A3412;">
                    <b>Nome</b> e <b>CPF</b> são os únicos campos do motorista exigidos pela SEFAZ no grupo <i>condutor</i> do MDF-e. Os demais dados são essenciais para o controle operacional.
                </MudText>
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Contato</MudText>

            <div class="motorista-row-contato mt-2">
                <MudTextField @bind-Value="_model.Telefone"
                              Label="Celular / WhatsApp"
                              Mask="@(new PatternMask("(00) 00000-0000"))"
                              Placeholder="(00) 00000-0000"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Email"
                              Label="E-mail"
                              Placeholder="motorista@email.com"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined" />
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Carteira Nacional de Habilitação</MudText>

            <div class="motorista-row-cnh-1 mt-2">
                <MudTextField @bind-Value="_model.Cnh"
                              Label="Número da CNH"
                              Placeholder="00000000000"
                              MaxLength="11"
                              Required="true"
                              RequiredError="Campo obrigatório"
                              Variant="Variant.Outlined" />
                <MudSelect T="CategoriaCnh" @bind-Value="_model.Categoria" Label="Categoria" Required="true" RequiredError="Campo obrigatório" Variant="Variant.Outlined">
                    @foreach (var cat in Enum.GetValues<CategoriaCnh>())
                    {
                        <MudSelectItem T="CategoriaCnh" Value="@cat">@cat</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_model.ValidadeCnh"
                              Label="Validade"
                              Placeholder="dd/mm/aaaa"
                              Required="true"
                              RequiredError="Campo obrigatório"
                              Variant="Variant.Outlined" />
                <MudSelect T="string" @bind-Value="_model.UfCnh" Label="UF Emissora" Variant="Variant.Outlined">
                    @foreach (var uf in _ufs)
                    {
                        <MudSelectItem T="string" Value="@uf">@uf</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="motorista-row-cnh-2 mt-4">
                <MudTextField @bind-Value="_model.NumeroRegistroDetran"
                              Label="Número de Registro (DETRAN)"
                              Placeholder="Número do registro no DETRAN"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.DataPrimeiraHabilitacao"
                              Label="Data de Primeira Habilitação"
                              Placeholder="dd/mm/aaaa"
                              Variant="Variant.Outlined" />
            </div>

            <div class="veiculo-alerta-sucesso mt-4">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#2E7D32;" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="color:#166534;">
                    Para condução de caminhões e carretas com carga (MDF-e de carga rodoviária), a CNH deve ser <b>categoria C, D ou E</b>. Categoria E é obrigatória para veículos articulados acima de 19 toneladas.
                </MudText>
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">MOPP — Movimentação Operacional de Produtos Perigosos</MudText>

            <MudCheckBox T="bool" @bind-Value="_model.HabilitadoMopp" Label="Motorista habilitado para transporte de produtos perigosos (MOPP)" Color="Color.Primary" Class="mt-2" />

            <div class="motorista-row-mopp mt-2">
                <MudTextField @bind-Value="_model.CertificadoMopp"
                              Label="Número do Certificado MOPP"
                              Placeholder="Ex: MOPP-2024-SP-00234"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.ValidadeMopp"
                              Label="Validade do Certificado"
                              Placeholder="dd/mm/aaaa"
                              Variant="Variant.Outlined" />
            </div>

            <div class="motorista-alerta-mopp mt-4">
                <MudIcon Icon="@Icons.Material.Filled.Info" Style="color:#2C6FB0;" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="color:#1E40AF;">
                    O MOPP é exigido quando o MDF-e transporta mercadorias classificadas como <b>produtos perigosos</b>. O certificado deve estar válido na data do embarque e é emitido pelo SENAC/SENAT.
                </MudText>
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Endereço Residencial</MudText>

            <div class="motorista-row-endereco-1 mt-2">
                <MudTextField @bind-Value="_model.Cep" Label="CEP" Mask="@(new PatternMask("00000-000"))" Placeholder="00000-000" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Logradouro" Label="Logradouro" Placeholder="Rua, Av..." Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Numero" Label="Número" Placeholder="123" Variant="Variant.Outlined" />
            </div>

            <div class="motorista-row-endereco-2 mt-4">
                <MudTextField @bind-Value="_model.Bairro" Label="Bairro" Placeholder="Bairro" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Municipio" Label="Cidade" Placeholder="Cidade" Variant="Variant.Outlined" />
                <MudSelect T="string" @bind-Value="_model.UfResidencia" Label="UF" Variant="Variant.Outlined">
                    @foreach (var uf in _ufs)
                    {
                        <MudSelectItem T="string" Value="@uf">@uf</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Vinculação Operacional</MudText>

            <div class="motorista-row-vinculacao mt-2">
                <MudSelect T="string" @bind-Value="_model.TransportadoraCodigo" Label="Transportadora" Placeholder="Selecione..." Variant="Variant.Outlined">
                    @foreach (var transportadora in TransportadoraMockData.Transportadoras)
                    {
                        <MudSelectItem T="string" Value="@transportadora.Codigo">@transportadora.NomeFantasia</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_model.VeiculoId" Label="Veículo Padrão" Placeholder="Nenhum (vincular por MDF-e)" Variant="Variant.Outlined">
                    @foreach (var veiculo in VeiculoMockData.Veiculos)
                    {
                        <MudSelectItem T="string" Value="@veiculo.Codigo">@veiculo.Placa — @veiculo.Marca @veiculo.Modelo</MudSelectItem>
                    }
                </MudSelect>
                <MudCheckBox T="bool" @bind-Value="_model.Ativo" Label="Motorista ativo" Color="Color.Primary" />
            </div>

            <MudTextField @bind-Value="_model.Observacoes"
                          Label="Observações"
                          Placeholder="Restrições de rota, observações de saúde, disponibilidade..."
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mt-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="Salvar">
            @(MotoristaExistente is null ? "Salvar" : "Salvar Alterações")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public MotoristaItem? MotoristaExistente { get; set; }

    private MudForm _form = null!;
    private MotoristaFormModel _model = new();

    private class MotoristaFormModel
    {
        public string Nome { get; set; } = string.Empty;
        public string? Cpf { get; set; }
        public string? DataNascimento { get; set; }
        public string? Telefone { get; set; }
        public string? Email { get; set; }
        public string? Cnh { get; set; }
        public CategoriaCnh Categoria { get; set; } = CategoriaCnh.C;
        public string? ValidadeCnh { get; set; }
        public string UfCnh { get; set; } = "SP";
        public string? NumeroRegistroDetran { get; set; }
        public string? DataPrimeiraHabilitacao { get; set; }
        public bool HabilitadoMopp { get; set; }
        public string? CertificadoMopp { get; set; }
        public string? ValidadeMopp { get; set; }
        public string? Cep { get; set; }
        public string? Logradouro { get; set; }
        public string? Numero { get; set; }
        public string? Bairro { get; set; }
        public string? Municipio { get; set; }
        public string? UfResidencia { get; set; } = "SP";
        public string? TransportadoraCodigo { get; set; }
        public string? VeiculoId { get; set; }
        public bool Ativo { get; set; } = true;
        public string? Observacoes { get; set; }
    }

    private readonly string[] _ufs =
    {
        "AC","AL","AP","AM","BA","CE","DF","ES","GO",
        "MA","MT","MS","MG","PA","PB","PR","PE","PI",
        "RJ","RN","RS","RO","RR","SC","SP","SE","TO"
    };

    protected override void OnInitialized()
    {
        if (MotoristaExistente is null) return;

        var m = MotoristaExistente;

        _model.Nome = m.Nome;
        _model.Cpf = m.Cpf;
        _model.DataNascimento = m.DataNascimento;
        _model.Telefone = m.Telefone;
        _model.Email = m.Email;
        _model.Cnh = m.Cnh;
        _model.Categoria = m.Categoria;
        _model.ValidadeCnh = m.ValidadeCnh.ToString("dd/MM/yyyy");
        _model.UfCnh = m.UfCnh;
        _model.NumeroRegistroDetran = m.NumeroRegistroDetran;
        _model.DataPrimeiraHabilitacao = m.DataPrimeiraHabilitacao;
        _model.HabilitadoMopp = m.HabilitadoMopp;
        _model.CertificadoMopp = m.CertificadoMopp;
        _model.ValidadeMopp = m.ValidadeMopp?.ToString("dd/MM/yyyy");
        _model.Cep = m.Cep;
        _model.Logradouro = m.Logradouro;
        _model.Numero = m.Numero;
        _model.Bairro = m.Bairro;
        _model.Municipio = m.Municipio;
        _model.UfResidencia = m.UfResidencia;
        _model.TransportadoraCodigo = m.TransportadoraCodigo;
        _model.VeiculoId = m.VeiculoId;
        _model.Ativo = m.Status == StatusMotorista.Ativo;
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Salvar()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}