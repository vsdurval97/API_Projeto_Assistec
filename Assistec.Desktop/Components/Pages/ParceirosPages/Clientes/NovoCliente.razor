<MudDialog>
    <TitleContent>
    <div>
        <MudText Typo="Typo.h6" Style="font-weight:600;">@(ClienteExistente is null ? "Novo Cliente" : "Editar Cliente")</MudText>
        <MudText Typo="Typo.body2" Style="color:#5A6B7A;">
            @(ClienteExistente is null ? "Preencha os dados do cliente" : "Atualize os dados do cliente")
        </MudText>
    </div>
</TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; display:block; margin-bottom:8px;">Tipo de Pessoa</MudText>
            <MudRadioGroup T="TipoPessoa" @bind-Value="_model.TipoPessoa" Class="mb-4">
                <MudRadio T="TipoPessoa" Value="TipoPessoa.Fisica" Color="Color.Primary">Pessoa Física</MudRadio>
                <MudRadio T="TipoPessoa" Value="TipoPessoa.Juridica" Color="Color.Primary">Pessoa Jurídica</MudRadio>
            </MudRadioGroup>

            <div class="@(_model.TipoPessoa == TipoPessoa.Juridica ? "cliente-row-nome-doc-cnpj" : "cliente-row-nome-doc")">
    <MudTextField @bind-Value="_model.Nome"
                  Label="@(_model.TipoPessoa == TipoPessoa.Fisica ? "Nome" : "Razão Social")"
                  Placeholder="Nome completo"
                  Required="true"
                  RequiredError="Nome é obrigatório"
                  Variant="Variant.Outlined" />
    <MudTextField @bind-Value="_model.Documento"
                  Label="@(_model.TipoPessoa == TipoPessoa.Fisica ? "CPF" : "CNPJ")"
                  Mask="@(_model.TipoPessoa == TipoPessoa.Fisica ? new PatternMask("000.000.000-00") : new PatternMask("00.000.000/0000-00"))"
                  Placeholder="@(_model.TipoPessoa == TipoPessoa.Fisica ? "000.000.000-00" : "00.000.000/0000-00")"
                  Variant="Variant.Outlined" />
    @if (_model.TipoPessoa == TipoPessoa.Juridica)
    {
        <MudTooltip Text="Buscar dados pelo CNPJ (em breve)">
            <MudIconButton Icon="@Icons.Material.Filled.Search"
                           Variant="Variant.Outlined"
                           Style="height:56px; width:56px;"
                           Disabled="true" />
        </MudTooltip>
    }
</div>

            <div class="cliente-row-tel-email mt-4">
                <MudTextField @bind-Value="_model.Telefone"
                              Label="Telefone / WhatsApp"
                              Mask="@(new PatternMask("(00) 00000-0000"))"
                              Placeholder="(00) 00000-0000"
                              Required="true"
                              RequiredError="Telefone é obrigatório"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Email"
                              Label="E-mail"
                              Placeholder="email@exemplo.com"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined" />
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Endereço</MudText>

            <div class="cliente-row-endereco-1 mt-2">
                <MudTextField @bind-Value="_model.Cep"
                              Label="CEP"
                              Mask="@(new PatternMask("00000-000"))"
                              Placeholder="00000-000"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Logradouro"
                              Label="Logradouro"
                              Placeholder="Rua, Av..."
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Numero"
                              Label="Número"
                              Placeholder="123"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Complemento"
              Label="Complemento"
              Placeholder="Apto, sala, bloco..."
              Variant="Variant.Outlined" />              
            </div>

            <div class="cliente-row-endereco-2 mt-4">
                <MudTextField @bind-Value="_model.Bairro"
                              Label="Bairro"
                              Placeholder="Bairro"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Municipio"
                              Label="Cidade"
                              Placeholder="Cidade"
                              Variant="Variant.Outlined" />
                <MudSelect T="string" @bind-Value="_model.Uf" Label="UF" Variant="Variant.Outlined">
                    @foreach (var uf in _ufs)
                    {
                        <MudSelectItem T="string" Value="@uf">@uf</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600;">Dados Fiscais</MudText>

<div class="cliente-row-tel-email mt-2">
    <MudSelect T="IndicadorIE" @bind-Value="_model.IndicadorIe" Label="Indicador de Inscrição Estadual" Variant="Variant.Outlined">
        <MudSelectItem T="IndicadorIE" Value="IndicadorIE.ContribuinteIcms">Contribuinte ICMS</MudSelectItem>
        <MudSelectItem T="IndicadorIE" Value="IndicadorIE.ContribuinteIsento">Contribuinte Isento</MudSelectItem>
        <MudSelectItem T="IndicadorIE" Value="IndicadorIE.NaoContribuinte">Não Contribuinte</MudSelectItem>
    </MudSelect>

    <MudTextField @bind-Value="_model.InscricaoEstadual"
                  Label="Inscrição Estadual"
                  Placeholder="Número da IE ou ISENTO"
                  Variant="Variant.Outlined" />
</div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancelar">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="Salvar">
    @(ClienteExistente is null ? "Salvar" : "Salvar Alterações")
</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private ClienteFormModel _model = new();

    private enum TipoPessoa { Fisica, Juridica }
    private enum IndicadorIE { ContribuinteIcms, ContribuinteIsento, NaoContribuinte }

    private class ClienteFormModel
    {
        public TipoPessoa TipoPessoa { get; set; } = TipoPessoa.Fisica;
        public string Nome { get; set; } = string.Empty;
        public string? Documento { get; set; }
        public string? Telefone { get; set; }
        public string? Email { get; set; }
        public string? Cep { get; set; }
        public string? Logradouro { get; set; }
        public string? Complemento { get; set; }
        public string? Numero { get; set; }
        public string? Bairro { get; set; }
        public string? Municipio { get; set; }
        public string? Uf { get; set; }
        public IndicadorIE IndicadorIe { get; set; } = IndicadorIE.NaoContribuinte;
        public string? InscricaoEstadual { get; set; }
    }

    private readonly string[] _ufs =
    {
        "AC","AL","AP","AM","BA","CE","DF","ES","GO",
        "MA","MT","MS","MG","PA","PB","PR","PE","PI",
        "RJ","RN","RS","RO","RR","SC","SP","SE","TO"
    };

    [Parameter] public ClienteItem? ClienteExistente { get; set; }

protected override void OnInitialized()
{
    if (ClienteExistente is null) return;

    var cliente = ClienteExistente;

    _model.TipoPessoa = cliente.TipoLabel == "PF" ? TipoPessoa.Fisica : TipoPessoa.Juridica;
    _model.Nome = cliente.Nome;
    _model.Documento = cliente.Documento;
    _model.Telefone = cliente.Telefone;
    _model.Email = cliente.Email;
    _model.Cep = cliente.Cep;
    _model.Logradouro = cliente.Logradouro;
    _model.Numero = cliente.Numero;
    _model.Bairro = cliente.Bairro;
    _model.Municipio = cliente.CidadeUf.Split(" / ").FirstOrDefault();
    _model.Uf = cliente.CidadeUf.Split(" / ").Skip(1).FirstOrDefault();
    _model.InscricaoEstadual = cliente.InscricaoEstadual;
    _model.IndicadorIe = cliente.InscricaoEstadual.Equals("ISENTO", StringComparison.OrdinalIgnoreCase)
        ? IndicadorIE.ContribuinteIsento
        : IndicadorIE.ContribuinteIcms;
}

    private void Cancelar() => MudDialog.Cancel();

    private void Salvar()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}