<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:600;">Contador</MudText>
        <MudText Typo="Typo.body1" Style="color:#5A6B7A;">
            Dados do contabilista responsável, exigidos para escrituração fiscal (SPED/EFD)
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save">
        Salvar Alterações
    </MudButton>
</div>

<MudForm @ref="_form" Model="_model" Class="mt-6">
    <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E0E4E8;">
        <MudText Typo="Typo.subtitle1" Style="font-weight:600; margin-bottom:16px;">
            1. Dados do Contabilista
        </MudText>

        <MudGrid Spacing="4">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Nome"
                              Label="Nome do Contabilista"
                              Placeholder="Ex: João da Silva"
                              Required="true"
                              RequiredError="Nome do contabilista é obrigatório"
                              MaxLength="60"
                              Counter="60"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_model.Cpf"
                              Label="CPF"
                              Mask="@(new PatternMask("000.000.000-00"))"
                              Placeholder="000.000.000-00"
                              Required="true"
                              RequiredError="CPF é obrigatório"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_model.Crc"
                              Label="CRC"
                              Placeholder="Ex: 1SP123456"
                              Required="true"
                              RequiredError="CRC é obrigatório"
                              Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="4" Class="mt-4">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Cnpj"
                              Label="CNPJ do Escritório de Contabilidade"
                              Mask="@_cnpjMask"
                              Placeholder="AA.AAA.AAA/AAAA-00"
                              HelperText="Preencha apenas se o contador atuar por meio de um escritório contábil"
                              Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mt-6" Elevation="0" Style="border:1px solid #E0E4E8;">
        <MudText Typo="Typo.subtitle1" Style="font-weight:600; margin-bottom:16px;">
            2. Endereço do Contabilista / Escritório
        </MudText>

        <MudGrid Spacing="4">
            <MudItem xs="12" sm="4" md="2">
                <MudTextField @bind-Value="_model.Cep"
                              Label="CEP"
                              Mask="@(new PatternMask("00000-000"))"
                              Placeholder="00000-000"
                              Required="true"
                              RequiredError="CEP é obrigatório"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="8" md="7">
                <MudTextField @bind-Value="_model.Logradouro"
                              Label="Logradouro / Rua"
                              Placeholder="Ex: Av. Paulista"
                              Required="true"
                              RequiredError="Logradouro é obrigatório"
                              MaxLength="100"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudTextField @bind-Value="_model.Numero"
                              Label="Número"
                              Placeholder="Ex: 123"
                              Required="true"
                              RequiredError="Número é obrigatório"
                              MaxLength="10"
                              Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="4" Class="mt-4">
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_model.Complemento"
                              Label="Complemento"
                              Placeholder="Ex: Sala 12"
                              MaxLength="60"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_model.Bairro"
                              Label="Bairro"
                              Placeholder="Ex: Centro"
                              Required="true"
                              RequiredError="Bairro é obrigatório"
                              MaxLength="60"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" @bind-Value="_model.Uf"
                           Label="Estado (UF)"
                           Variant="Variant.Outlined">
                    @foreach (var uf in _ufs)
                    {
                        <MudSelectItem T="string" Value="@uf">@uf</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_model.Municipio"
                              Label="Cidade / Município"
                              Placeholder="Ex: São Paulo"
                              Required="true"
                              RequiredError="Município é obrigatório"
                              MaxLength="60"
                              Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mt-6" Elevation="0" Style="border:1px solid #E0E4E8;">
        <MudText Typo="Typo.subtitle1" Style="font-weight:600; margin-bottom:16px;">
            3. Contato
        </MudText>

        <MudGrid Spacing="4">
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_model.Telefone"
                              Label="Telefone"
                              Mask="@(new PatternMask("(00) 00000-0000"))"
                              Placeholder="(00) 00000-0000"
                              Required="true"
                              RequiredError="Telefone é obrigatório"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_model.Fax"
                              Label="Fax"
                              Mask="@(new PatternMask("(00) 0000-0000"))"
                              Placeholder="(00) 0000-0000"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Email"
                              Label="E-mail"
                              Placeholder="contador@escritorio.com.br"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="E-mail é obrigatório"
                              Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudForm>

@code {
    private MudForm _form = null!;
    private ContadorModel _model = new();

    private class ContadorModel
    {
        public string Nome { get; set; } = string.Empty;
        public string? Cpf { get; set; }
        public string? Crc { get; set; }

        private string? _cnpj;
        public string? Cnpj
        {
            get => _cnpj;
            set => _cnpj = value?.ToUpperInvariant();
        }

        public string? Cep { get; set; }
        public string? Logradouro { get; set; }
        public string? Numero { get; set; }
        public string? Complemento { get; set; }
        public string? Bairro { get; set; }
        public string? Uf { get; set; }
        public string? Municipio { get; set; }

        public string? Telefone { get; set; }
        public string? Fax { get; set; }
        public string? Email { get; set; }
    }

    private readonly PatternMask _cnpjMask = new("**.***.***/****-00")
    {
        MaskChars = new[]
        {
            new MaskChar('*', @"[0-9A-Za-z]"),
            new MaskChar('0', @"[0-9]")
        }
    };

    private readonly string[] _ufs =
    {
        "AC","AL","AP","AM","BA","CE","DF","ES","GO",
        "MA","MT","MS","MG","PA","PB","PR","PE","PI",
        "RJ","RN","RS","RO","RR","SC","SP","SE","TO"
    };
}