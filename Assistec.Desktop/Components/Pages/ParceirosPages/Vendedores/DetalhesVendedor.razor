@page "/parceiros/vendedores/{Codigo}"
@using Assistec.Desktop.Windowing
@using Assistec.Desktop.Components.Pages.ParceirosPages.Usuarios
@inject WindowManagerService WindowManager
@inject IDialogService DialogService

<div class="breadcrumb-row">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" OnClick="VoltarParaVendedores" />
    <MudLink Underline="Underline.None" Style="color:#9AA5B1;">Parceiros</MudLink>
    <MudText Style="color:#9AA5B1;">/</MudText>
    <MudLink Underline="Underline.Hover" Style="color:#2C6FB0; cursor:pointer;" OnClick="VoltarParaVendedores">Vendedores</MudLink>
    <MudText Style="color:#9AA5B1;">/</MudText>
    <MudText Style="font-weight:600;">@(_usuario?.Nome ?? Codigo)</MudText>
</div>

@if (_vendedor is not null && _usuario is not null)
{
    <div class="fornecedor-detalhe-grid mt-4">
        <div class="fornecedor-detalhe-coluna">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E0E4E8;">
                <div class="usuario-perfil-avatar" style="background-color:@_usuario.CorAvatar;">@_usuario.Iniciais</div>
                <MudText Typo="Typo.subtitle1" Style="font-weight:600; text-align:center; margin-top:12px;">@_usuario.Nome</MudText>
                <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-align:center; display:block;">@_vendedor.Cargo</MudText>
                <MudText Typo="Typo.caption" Style="color:#9AA5B1; text-align:center; display:block;">@_vendedor.Codigo · @_vendedor.Regional</MudText>
                <div style="text-align:center; margin-top:8px;">
                    @if (_vendedor.Status == StatusVendedor.Ativo)
                    {
                        <MudChip T="string" Size="Size.Small" Style="background-color:#E4F2E5; color:#2E7D32;">Ativo</MudChip>
                    }
                    else if (_vendedor.Status == StatusVendedor.Inativo)
                    {
                        <MudChip T="string" Size="Size.Small" Style="background-color:#F0F2F4; color:#5A6B7A;">Inativo</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Style="background-color:#FCEFDB; color:#D9A441;">Férias</MudChip>
                    }
                </div>
                <MudButton Variant="Variant.Outlined" FullWidth="true" StartIcon="@Icons.Material.Filled.EditNote" Class="mt-4" OnClick="AbrirEdicao">
    Editar Cadastro
</MudButton>
            </MudPaper>

            <MudPaper Class="pa-4 mt-4" Elevation="0" Style="border:1px solid #E0E4E8;">
                <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600; margin-bottom:12px; display:block;">Regra de Comissão</MudText>
                <div class="fornecedor-condicoes-linha">
                    <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Tipo</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@_vendedor.TipoComissao</MudText>
                </div>
                <div class="fornecedor-condicoes-linha">
                    <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Base</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600; color:#8E5CE0;">@_vendedor.BaseFormatada</MudText>
                </div>
                <div class="fornecedor-condicoes-linha">
                    <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Meta Mensal</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@_vendedor.MetaMensalFormatada</MudText>
                </div>
                <div class="fornecedor-condicoes-linha">
                    <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Usuário</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@_vendedor.UsuarioCodigo</MudText>
                </div>
                <div class="fornecedor-condicoes-linha">
                    <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Cadastrado em</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@_vendedor.CadastradoEm.ToString("dd/MM/yyyy")</MudText>
                </div>
                <div class="fornecedor-condicoes-linha">
                    <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Última Venda</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@(_ultimaVenda?.ToString("dd/MM/yyyy") ?? "—")</MudText>
                </div>
            </MudPaper>

            <MudPaper Class="pa-4 mt-4" Elevation="0" Style="border:1px solid #E0E4E8;">
                <MudText Typo="Typo.caption" Style="color:#5A6B7A; text-transform:uppercase; letter-spacing:0.03em; font-weight:600; margin-bottom:12px; display:block;">Resumo Geral</MudText>
                <div class="fornecedor-condicoes-linha">
                    <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Total Vendido</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:700;">@_vendedor.TotalVendidoFormatadoCheio</MudText>
                </div>
                <div class="fornecedor-condicoes-linha">
                    <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Total Comissão</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:700; color:#8E5CE0;">@_vendedor.TotalComissaoHistoricoFormatado</MudText>
                </div>
                <div class="fornecedor-condicoes-linha">
                    <MudText Typo="Typo.body2" Style="color:#5A6B7A;">Ticket Médio</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:700;">@_vendedor.TicketMedioFormatado</MudText>
                </div>
            </MudPaper>
        </div>

        <div>
            <div class="vendedor-kpi-row">
                <div class="info-card">
                    <div class="info-card-icon" style="background-color:#F1E9FA;">
                        <MudIcon Icon="@Icons.Material.Filled.Paid" Style="color:#8E5CE0;" />
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Style="color:#5A6B7A;">Faturado no Mês</MudText>
                        <MudText Typo="Typo.h6" Style="font-weight:600;">@_faturadoNoMesFormatado</MudText>
                        <MudText Typo="Typo.caption" Style="color:#9AA5B1;">@(_ultimoMes?.Mes ?? "—")</MudText>
                    </div>
                </div>
                <div class="info-card">
                    <div class="info-card-icon" style="background-color:#F1E9FA;">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#8E5CE0;" />
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Style="color:#5A6B7A;">Comissão do Mês</MudText>
                        <MudText Typo="Typo.h6" Style="font-weight:600; color:#8E5CE0;">@_comissaoNoMesFormatada</MudText>
                        <MudText Typo="Typo.caption" Style="color:#9AA5B1;">faturado e pago</MudText>
                    </div>
                </div>
                <div class="info-card">
                    <div class="info-card-icon" style="background-color:#FCEFDB;">
                        <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Style="color:#D9A441;" />
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Style="color:#5A6B7A;">Meta do Mês</MudText>
                        <MudText Typo="Typo.h6" Style="font-weight:600; color:#D9A441;">@(_ultimoMes?.Percentual.ToString("0"))%</MudText>
                        <MudText Typo="Typo.caption" Style="color:#9AA5B1;">@(_ultimoMes?.RealizadoCompacto) / @(_ultimoMes?.MetaCompacta)</MudText>
                    </div>
                </div>
            </div>

            <MudPaper Class="pa-4 mt-4" Elevation="0" Style="border:1px solid #E0E4E8;">
                <MudTabs Elevation="0" Rounded="true" PanelClass="pt-4">
                    <MudTabPanel Text="Histórico de Vendas">
                        <div style="overflow-x:auto;">
                            <table class="vendedor-vendas-table">
                                <thead>
                                    <tr>
                                        <th>Pedido</th>
                                        <th>Data</th>
                                        <th>Cliente</th>
                                        <th class="col-num">Valor</th>
                                        <th class="col-num">Desconto</th>
                                        <th class="col-num">Comissão</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pedido in _vendas)
                                    {
                                        <tr>
                                            <td><MudLink Href="#" Underline="Underline.None">@pedido.Numero</MudLink></td>
                                            <td>@pedido.Data.ToString("dd/MM/yyyy")</td>
                                            <td>@pedido.Cliente</td>
                                            <td class="col-num">@pedido.ValorFormatado</td>
                                            <td class="col-num" style="@(pedido.Desconto > 0 ? "color:#C2185B;" : "")">@pedido.DescontoFormatado</td>
                                            <td class="col-num"><MudText Typo="Typo.body2" Style="color:#8E5CE0; font-weight:600;">@pedido.ComissaoFormatada</MudText></td>
                                            <td>
                                                @if (pedido.Status == StatusPedidoVenda.Faturado)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Style="background-color:#E4F2E5; color:#2E7D32;">Faturado</MudChip>
                                                }
                                                else if (pedido.Status == StatusPedidoVenda.Pendente)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Style="background-color:#FCEFDB; color:#D9A441;">Pendente</MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Size="Size.Small" Style="background-color:#FBE4EC; color:#C2185B;">Cancelado</MudChip>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (_vendas.Count > 0)
                        {
                            <div class="vendedor-vendas-footer">
                                <MudText Typo="Typo.body2" Style="font-weight:600;">Total Faturado</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">@_faturadoNoMesFormatado</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600; color:#8E5CE0;">@_comissaoNoMesFormatada</MudText>
                            </div>
                        }
                    </MudTabPanel>

                    <MudTabPanel Text="Evolução de Metas">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Evolução dos últimos 6 meses</MudText>

                        <div class="vendedor-metas-legenda">
                            <span class="legenda-item"><span class="legenda-dot" style="background-color:#E0E4E8;"></span> Meta</span>
                            <span class="legenda-item"><span class="legenda-dot" style="background-color:#8E5CE0;"></span> Realizado</span>
                            <span class="legenda-item"><span class="legenda-dot" style="background-color:#2E7D32;"></span> Atingiu meta</span>
                        </div>

                        <div class="vendedor-minichart">
                            @foreach (var mes in _evolucao)
                            {
                                <div class="vendedor-minichart-col">
                                    <div class="vendedor-minichart-track">
                                        <div class="vendedor-minichart-fill"
                                             style="height:@(Math.Min(mes.Percentual, 120) / 120 * 100)%; background-color:@(mes.AtingiuMeta ? "#2E7D32" : "#8E5CE0");"></div>
                                    </div>
                                    <MudText Typo="Typo.caption" Style="color:#9AA5B1; margin-top:4px;">@mes.Mes</MudText>
                                </div>
                            }
                        </div>

                        <div class="vendedor-metas-lista mt-4">
                            @foreach (var mes in _evolucao)
                            {
                                <div class="vendedor-metas-linha">
                                    <MudText Typo="Typo.body2" Style="width:56px; color:#5A6B7A;">@mes.Mes</MudText>
                                    <div class="vendedor-metas-barra-track">
                                        <div class="vendedor-metas-barra-fill"
                                             style="width:@(Math.Min(mes.Percentual, 100))%; background-color:@(mes.AtingiuMeta ? "#2E7D32" : "#8E5CE0");"></div>
                                    </div>
                                    <MudText Typo="Typo.body2" Style="@($"width:48px; text-align:right; font-weight:600; color:{(mes.AtingiuMeta ? "#2E7D32" : "#8E5CE0")};")">@mes.Percentual.ToString("0")%</MudText>
                                    <MudText Typo="Typo.caption" Style="width:140px; text-align:right; color:#9AA5B1;">@mes.RealizadoCompacto / @mes.MetaCompacta</MudText>
                                </div>
                            }
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </div>
    </div>
}
else
{
    <MudText Typo="Typo.body1" Style="color:#5A6B7A; margin-top:16px;">Vendedor não encontrado.</MudText>
}

@code {
    [Parameter] public string Codigo { get; set; } = string.Empty;

    [CascadingParameter(Name = "WindowId")] public Guid WindowId { get; set; }

    private VendedorItem? _vendedor;
    private UsuarioItem? _usuario;
    private List<PedidoVendaItem> _vendas = new();
    private List<EvolucaoMetaItem> _evolucao = new();

    private async Task AbrirEdicao()
{
    var parameters = new DialogParameters<NovoVendedor> { { x => x.VendedorExistente, _vendedor } };
    var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
    await DialogService.ShowAsync<NovoVendedor>("Editar Vendedor", parameters, options);
}
    
    protected override void OnParametersSet()
    {
        _vendedor = VendedorMockData.Vendedores.FirstOrDefault(v => v.Codigo == Codigo);
        _usuario = _vendedor is null ? null : UsuarioMockData.Usuarios.FirstOrDefault(u => u.Codigo == _vendedor.UsuarioCodigo);
        _vendas = PedidoVendaMockData.Pedidos.Where(p => p.VendedorCodigo == Codigo).OrderByDescending(p => p.Data).ToList();
        _evolucao = EvolucaoMetaMockData.Evolucao.Where(e => e.VendedorCodigo == Codigo).ToList();
    }

    private DateTime? _ultimaVenda => _vendas.Count > 0 ? _vendas.Max(v => v.Data) : null;

    private EvolucaoMetaItem? _ultimoMes => _evolucao.Count > 0 ? _evolucao[^1] : null;

    private double _faturadoNoMes => _vendas.Where(v => v.Status == StatusPedidoVenda.Faturado).Sum(v => v.Valor);
    private double _comissaoNoMes => _vendas.Where(v => v.Status == StatusPedidoVenda.Faturado).Sum(v => v.Comissao);

    private static string FormatarMoeda(double valor) => $"R$ {valor:N2}".Replace(",", "#").Replace(".", ",").Replace("#", ".");

    private string _faturadoNoMesFormatado => FormatarMoeda(_faturadoNoMes);
    private string _comissaoNoMesFormatada => FormatarMoeda(_comissaoNoMes);

    private void VoltarParaVendedores()
    {
        WindowManager.Navigate(WindowId, typeof(ListaVendedores), null, "Vendedores");
    }
}