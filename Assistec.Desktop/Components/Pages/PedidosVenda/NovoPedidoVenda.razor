@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <div style="display:flex; align-items:center; gap:10px;">
            <MudText Typo="Typo.h6" Style="font-weight:600;">
                @(_novo ? "Novo Pedido de Venda" : _pedido.Numero)
            </MudText>
            @{
                var cor = PedidoVendaUi.Cor(_pedido.Status);
            }
            <MudChip T="string" Size="Size.Small"
                     Style="@($"background-color:{cor.Fundo}; color:{cor.Texto}; font-weight:600;")">
                @PedidoVendaUi.Rotulo(_pedido.Status)
            </MudChip>
        </div>
        <MudText Typo="Typo.body2" Style="color:#5A6B7A;">
            Registre os dados comerciais, produtos e condições de entrega.
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudTabs Elevation="0" Rounded="false" PanelClass="pt-4">

            <MudTabPanel Text="Dados Gerais">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string"
                                   Label="Cliente"
                                   Required="true"
                                   Value="_pedido.Cliente"
                                   ValueChanged="OnClienteAlterado"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var c in PedidoVendaMockData.Clientes)
                            {
                                <MudSelectItem T="string" Value="@c.Nome">@c.Nome</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" Label="CPF/CNPJ" @bind-Value="_pedido.Documento"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" Label="Telefone" @bind-Value="_pedido.Telefone"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="E-mail" @bind-Value="_pedido.Email"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudDatePicker Label="Emissão" @bind-Date="_pedido.Emissao" DateFormat="dd/MM/yyyy"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudDatePicker Label="Previsão de Entrega" @bind-Date="_pedido.Entrega" DateFormat="dd/MM/yyyy"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="Vendedor" @bind-Value="_pedido.Vendedor"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var v in PedidoVendaMockData.Vendedores)
                            {
                                <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" Label="Origem" @bind-Value="_pedido.Origem"
                                      Placeholder="Venda direta ou orçamento"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudSelect T="StatusPedido" Label="Status" @bind-Value="_pedido.Status"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var s in Enum.GetValues<StatusPedido>())
                            {
                                <MudSelectItem T="StatusPedido" Value="@s">@PedidoVendaUi.Rotulo(s)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <div class="pv-separador" style="margin-top:4px;">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:600;">Endereço do Cliente</MudText>
                            <MudText Typo="Typo.caption" Style="color:#9AA5B1;">
                                Endereço utilizado como destino padrão deste pedido.
                            </MudText>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" Label="CEP" Placeholder="00000-000" @bind-Value="_pedido.Endereco.Cep"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Logradouro" @bind-Value="_pedido.Endereco.Logradouro"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" Label="Número" @bind-Value="_pedido.Endereco.Numero"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" Label="Complemento" @bind-Value="_pedido.Endereco.Complemento"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" Label="Bairro" @bind-Value="_pedido.Endereco.Bairro"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField T="string" Label="Cidade" @bind-Value="_pedido.Endereco.Cidade"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudSelect T="string" Label="UF" @bind-Value="_pedido.Endereco.Uf"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var uf in PedidoVendaMockData.Ufs)
                            {
                                <MudSelectItem T="string" Value="@uf">@uf</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="@($"Produtos ({_pedido.Itens.Count})")">
                <div class="pv-busca-barra">
                    <div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:600;">Produtos do Pedido</MudText>
                        <MudText Typo="Typo.caption" Style="color:#9AA5B1;">
                            Busque no catálogo e consulte o saldo disponível antes de incluir.
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="AbrirBuscaProduto">
                        Buscar Produto
                    </MudButton>
                </div>

                <MudPaper Elevation="0" Class="mt-3" Style="border:1px solid #E0E4E8; overflow-x:auto;">
                    <table class="pv-table">
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Estoque</th>
                                <th>Qtd.</th>
                                <th>Valor Unit.</th>
                                <th>Desc. %</th>
                                <th class="pv-col-num">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _pedido.Itens)
                            {
                                <tr>
                                    <td>
                                        <div class="pv-cliente">@item.Descricao</div>
                                        <div class="pv-sub">@item.Codigo · @item.Unidade</div>
                                    </td>
                                    <td>@item.Estoque @item.Unidade</td>
                                    <td>
                                        <MudNumericField T="int" @bind-Value="item.Quantidade" Min="1" Immediate="true"
                                                         HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Class="pv-input-qtd" />
                                    </td>
                                    <td>
                                        <MudNumericField T="decimal" @bind-Value="item.ValorUnitario" Min="0" Immediate="true"
                                                         HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Class="pv-input-valor" />
                                    </td>
                                    <td>
                                        <MudNumericField T="decimal" @bind-Value="item.Desconto" Min="0" Max="100" Immediate="true"
                                                         HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Class="pv-input-qtd" />
                                    </td>
                                    <td class="pv-col-num pv-total">@PedidoVendaUi.Moeda(item.Total)</td>
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       Style="color:#9AA5B1;"
                                                       OnClick="@(() => RemoverItem(item))" />
                                    </td>
                                </tr>
                            }
                            @if (_pedido.Itens.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="pv-vazio">Nenhum produto adicionado ao pedido.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="Valores e Entrega">
                <div class="pv-valores-layout">
                    <div class="pv-detalhe-col">
                        <MudSelect T="string" Label="Condição de Pagamento" @bind-Value="_pedido.CondicaoPagamento"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var c in PedidoVendaMockData.CondicoesPagamento)
                            {
                                <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string" Label="Transportadora" @bind-Value="_pedido.Transportadora"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var t in PedidoVendaMockData.Transportadoras)
                            {
                                <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                            }
                        </MudSelect>

                        <MudTextField T="string" Label="Observações do Pedido" @bind-Value="_pedido.Observacao"
                                      Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>

                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid #E0E4E8; height:fit-content;">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;" Class="mb-2">Resumo Financeiro</MudText>
                        <div class="pv-resumo-linha"><span>Produtos</span><strong>@PedidoVendaUi.Moeda(_pedido.Subtotal)</strong></div>
                        <div class="pv-resumo-linha">
                            <span>Desconto geral</span>
                            <MudNumericField T="decimal" @bind-Value="_pedido.Desconto" Min="0" Immediate="true"
                                             HideSpinButtons="true" Adornment="Adornment.Start" AdornmentText="R$"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="pv-input-valor" />
                        </div>
                        <div class="pv-resumo-linha">
                            <span>Frete</span>
                            <MudNumericField T="decimal" @bind-Value="_pedido.Frete" Min="0" Immediate="true"
                                             HideSpinButtons="true" Adornment="Adornment.Start" AdornmentText="R$"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="pv-input-valor" />
                        </div>
                        <div class="pv-resumo-total">
                            <span>Total do Pedido</span>
                            <strong>@PedidoVendaUi.Moeda(_pedido.Total)</strong>
                        </div>
                    </MudPaper>
                </div>
            </MudTabPanel>

        </MudTabs>
    </DialogContent>

    <DialogActions>
        <MudText Typo="Typo.caption" Style="color:#9AA5B1; margin-right:auto; padding-left:8px;">
            @_pedido.Itens.Count item(ns) · @PedidoVendaUi.Moeda(_pedido.Total)
        </MudText>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(!PodeSalvar)" OnClick="Salvar">
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PedidoVendaItem? PedidoExistente { get; set; }

    private PedidoVendaItem _pedido = new();
    private bool _novo => PedidoExistente is null;

    private bool PodeSalvar =>
        !string.IsNullOrWhiteSpace(_pedido.Cliente) && _pedido.Itens.Count > 0;

    protected override void OnInitialized()
    {
        _pedido = PedidoExistente?.Clonar() ?? new PedidoVendaItem
        {
            Numero = PedidoVendaMockData.ProximoNumero(),
            Emissao = DateTime.Today,
            Vendedor = PedidoVendaMockData.Vendedores[0],
            Origem = "Venda direta",
            Status = StatusPedido.Rascunho,
            CondicaoPagamento = "À vista",
            Endereco = new EnderecoPedido { Uf = "SP" }
        };
    }

    private void OnClienteAlterado(string nome)
    {
        _pedido.Cliente = nome;

        var cliente = PedidoVendaMockData.Clientes.FirstOrDefault(c => c.Nome == nome);
        if (cliente is null) return;

        _pedido.Documento = cliente.Documento;
        _pedido.Telefone = cliente.Telefone;
        _pedido.Email = cliente.Email;
        _pedido.Endereco = cliente.Endereco.Clonar();
    }

    private async Task AbrirBuscaProduto()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<BuscaProdutoPedidoVenda>("", options);
        var resultado = await dialog.Result;

        if (resultado is { Canceled: false, Data: ItemPedidoLinha produto })
        {
            var existente = _pedido.Itens.FirstOrDefault(i => i.Codigo == produto.Codigo);
            if (existente is not null)
                existente.Quantidade += produto.Quantidade;
            else
                _pedido.Itens.Add(produto);
        }
    }

    private void RemoverItem(ItemPedidoLinha item) => _pedido.Itens.Remove(item);

    private void Cancelar() => MudDialog.Cancel();

    private void Salvar()
    {
        if (!PodeSalvar) return;
        PedidoVendaMockData.Salvar(_pedido);
        MudDialog.Close(DialogResult.Ok(_pedido));
    }
}