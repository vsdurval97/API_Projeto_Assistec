            Dashboard
        </MudNavLink>

        <MudNavLink Href="/emitente"
            Icon="@Icons.Material.Filled.ViewModule">
            Emitente
        </MudNavLink>

        <MudNavLink Href="/certificado"
                    Icon="@Icons.Material.Filled.VerifiedUser">
            Certificado
        </MudNavLink>

        <MudNavLink Href="/parceiros"
                    Icon="@Icons.Material.Filled.People">
            Parceiros
        </MudNavLink>

        <MudNavLink Href="#" Disabled="true"
                    Icon="@Icons.Material.Filled.Inventory2">
            Estoque
        </MudNavLink>

        <MudNavLink Href="#" Disabled="true"
                    Icon="@Icons.Material.Filled.Build">
            Ordem de Serviço
        </MudNavLink>

        <MudNavLink Href="#" Disabled="true"
                    Icon="@Icons.Material.Filled.ShoppingCart">
            Orçamento
        </MudNavLink>

        <MudNavLink Href="#" Disabled="true"
                    Icon="@Icons.Material.Filled.PointOfSale">
            Pedido de Venda
        </MudNavLink>

        <MudNavLink Href="#" Disabled="true"
                    Icon="@Icons.Material.Filled.Description">
            Faturamento
        </MudNavLink>

        <MudNavLink Href="#" Disabled="true"
                    Icon="@Icons.Material.Filled.AttachMoney">
            Financeiro
        </MudNavLink>

        <MudNavLink Href="#" Disabled="true"
                    Icon="@Icons.Material.Filled.BarChart">
            Relatórios
        </MudNavLink>

        <MudNavLink Href="#" Disabled="true"
                    Icon="@Icons.Material.Filled.Settings">
            Configurações
        </MudNavLink>
    </MudNavMenu>

    @using Assistec.Desktop.Windowing
@inject WindowManagerService WindowManager
@implements IDisposable

<div style="display:flex; flex-direction:column; height:100%; padding:16px 8px;">
    
    @if (WindowManager.Windows.Any(w => w.IsMinimized))
    {
        <div class="nav-minimized-windows">
            @foreach (var window in WindowManager.Windows.Where(w => w.IsMinimized))
            {
                <div class="nav-minimized-item" @onclick="() => WindowManager.Restore(window.Id)">
                    <MudIcon Icon="@window.Icon" Size="Size.Small" />
                    <MudText Typo="Typo.caption" Style="color:#FFFFFF;">@window.Title</MudText>
                </div>
            }
        </div>
    }

    <div class="nav-footer">
        <MudText Typo="Typo.caption" Style="display:block;">Serial: AST-0001-2026</MudText>
        <MudText Typo="Typo.caption" Style="display:block;">Versão 0.1.0</MudText>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        WindowManager.OnChange += HandleChange;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        WindowManager.OnChange -= HandleChange;
    }
}   

</div>