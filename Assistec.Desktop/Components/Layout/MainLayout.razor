@inherits LayoutComponentBase
@implements IDisposable
@using Assistec.Desktop.Theme
@using Assistec.Desktop.Windowing
@inject WindowManagerService WindowManager

<MudThemeProvider Theme="AssistecTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Style="background-color:#FFFFFF; color:#10233A;">
        <MudText Typo="Typo.h6" Style="font-weight:600;">AssisTec</MudText>

        <MudSpacer />

        <MudTextField T="string"
                      Placeholder="Buscar rápida (F10)..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Margin="Margin.Dense"
                      Variant="Variant.Outlined"
                      Style="max-width:360px; width:100%;" />

        <MudSpacer />

        <div style="display:flex; align-items:center; gap:12px;">
            <div style="text-align:right; line-height:1.1;">
                <MudText Typo="Typo.body2" Style="font-weight:600;">Administrador</MudText>
                <MudText Typo="Typo.caption" Style="color:#5A6B7A;">Usuário</MudText>
            </div>
            <MudAvatar Color="Color.Primary" Size="Size.Medium">A</MudAvatar>
        </div>
    </MudAppBar>

    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0"
               ClipMode="DrawerClipMode.Never" Width="220px">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Style="margin-left:220px; padding-top:64px;">
        <div class="content-area">
            <div style="padding:24px;">
                @Body
            </div>

            @{
    var visibleWindows = WindowManager.Windows.Where(w => !w.IsMinimized).ToList();
}
@for (var i = 0; i < visibleWindows.Count; i++)
{
    var window = visibleWindows[i];
    <div class="app-window" style="z-index:@(100 + i);">
                    <div class="app-window-header">
        <div class="app-window-title">
            <MudIcon Icon="@window.Icon" Size="Size.Small" />
            <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@window.Title</MudText>
        </div>
        <div class="app-window-actions">
            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                           OnClick="() => WindowManager.Minimize(window.Id)" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           OnClick="() => WindowManager.Close(window.Id)" />
        </div>
    </div>
    <div class="app-window-body">
    <CascadingValue Name="WindowId" Value="window.Id">
        <DynamicComponent Type="window.ComponentType" Parameters="window.Parameters" />
    </CascadingValue>
</div>
                </div>
            }
        </div>
    </MudMainContent>
</MudLayout>

@code {
    protected override void OnInitialized()
    {
        WindowManager.OnChange += HandleChange;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        WindowManager.OnChange -= HandleChange;
    }
}