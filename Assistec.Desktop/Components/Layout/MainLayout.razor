@inherits LayoutComponentBase
@using Assistec.Desktop.Theme

<MudThemeProvider Theme="AssistecTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Style="background-color:#FFFFFF; color:#10233A;">
        <MudText Typo="Typo.h6" Style="font-weight:600;">AssisTec</MudText>

        <MudSpacer />

        <MudTextField T="string"
                      Placeholder="Buscar rápida (F10)..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Margin="Margin.Dense"
                      Variant="Variant.Outlined"
                      Style="max-width:360px; width:100%;" />

        <MudSpacer />

        <div style="display:flex; align-items:center; gap:12px;">
            <div style="text-align:right; line-height:1.1;">
                <MudText Typo="Typo.body2" Style="font-weight:600;">Administrador</MudText>
                <MudText Typo="Typo.caption" Style="color:#5A6B7A;">Usuário</MudText>
            </div>
            <MudAvatar Color="Color.Primary" Size="Size.Medium">A</MudAvatar>
        </div>
    </MudAppBar>

    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0"
           ClipMode="DrawerClipMode.Never" Width="220px">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Style="margin-left:220px; padding-top:64px;">
        <div style="padding:24px;">
            @Body
        </div>
    </MudMainContent>
</MudLayout>