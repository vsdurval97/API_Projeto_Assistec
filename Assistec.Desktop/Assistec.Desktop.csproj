<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Assistec.Desktop</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>AssisTec</ApplicationTitle>
    <ApplicationId>com.assistec.desktop</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ForegroundScale evita o clipping do foreground (checklist maui-app-icons-splash) -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              ForegroundFile="Resources\AppIcon\appiconfg.svg"
              ForegroundScale="0.65"
              Color="#1f6feb" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1f6feb" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
  <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.20" />
</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assistec\Assistec.csproj" />
  </ItemGroup>

</Project>